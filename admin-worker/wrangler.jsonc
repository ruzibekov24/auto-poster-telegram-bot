{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harvard-path-admin-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harvard-path-bot",
      "database_id": "fa205d04-2480-4d1f-a593-a32f001790d1",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
