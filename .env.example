# Telegram bot token @BotFather'dan olinadi
BOT_TOKEN=123456789:AAExampleTokenHere

# Post tashlanadigan kanal username yoki ID (masalan @MyHarvardPath yoki -1001234567890)
CHANNEL_ID=@MyHarvardPath

# Anthropic Claude API kaliti (console.anthropic.com dan olinadi)
ANTHROPIC_API_KEY=sk-ant-api03-example

# Kanal footer'ida ko'rsatiladigan username (@ belgisi bilan)
CHANNEL_USERNAME=@MyHarvardPath

# Ixtiyoriy: har bir post natijasi (muvaffaqiyat/xato) haqida shaxsiy Telegram
# xabar olish uchun o'z chat ID'ingiz (@userinfobot orqali bilib olinadi)
ADMIN_CHAT_ID=

# Ixtiyoriy: healthchecks.io'da bepul akkaunt ochib, "Period: 1 day, Grace: 3 hours"
# sozlamali check yarating va shu yerdagi ping URL'ni qo'ying. Shunda bot butunlay
# to'xtab qolsa ham (server o'chsa, kod crash bo'lsa) sizga alohida ogohlantirish keladi.
HEALTHCHECK_URL=
